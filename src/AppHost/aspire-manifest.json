{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "redis": {
      "type": "container.v0",
      "connectionString": "{redis.bindings.tcp.host}:{redis.bindings.tcp.port}",
      "image": "docker.io/library/redis:7.4",
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 6379
        }
      }
    },
    "llama": {
      "type": "value.v0",
      "connectionString": "{ollama.connectionString};Model=qwen2.5-coder:3b"
    },
    "seq": {
      "type": "container.v0",
      "connectionString": "{seq.bindings.http.url}",
      "image": "docker.io/datalust/seq:2024.3",
      "env": {
        "ACCEPT_EULA": "Y"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 80
        }
      }
    },
    "api-chatbot": {
      "type": "project.v0",
      "path": "../Services/ApiChatBot/ApiChatBot.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{api-chatbot.bindings.http.targetPort}",
        "ConnectionStrings__redis": "{redis.connectionString}",
        "ConnectionStrings__seq": "{seq.connectionString}",
        "ConnectionStrings__llama": "{llama.connectionString}",
        "services__mcp-server__http__0": "{mcp-server.bindings.http.url}",
        "services__mcp-server__https__0": "{mcp-server.bindings.https.url}",
        "services__ollama__http__0": "{ollama.bindings.http.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "mcp-server": {
      "type": "project.v0",
      "path": "../Services/MCPServer/MCPServer.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{mcp-server.bindings.http.targetPort}",
        "services__api-chatbot__http__0": "{api-chatbot.bindings.http.url}",
        "services__api-chatbot__https__0": "{api-chatbot.bindings.https.url}",
        "ConnectionStrings__redis": "{redis.connectionString}",
        "ConnectionStrings__seq": "{seq.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "chatbotweb": {
      "type": "executable.v0",
      "workingDirectory": "../Frontends/chatbotweb",
      "command": "npm",
      "args": [
        "run",
        "start"
      ],
      "env": {
        "NODE_ENV": "development",
        "PORT": "{chatbotweb.bindings.http.targetPort}",
        "services__api-chatbot__http__0": "{api-chatbot.bindings.http.url}",
        "services__api-chatbot__https__0": "{api-chatbot.bindings.https.url}",
        "services__ollama__http__0": "{ollama.bindings.http.url}",
        "ConnectionStrings__seq": "{seq.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8000
        }
      }
    }
  }
}